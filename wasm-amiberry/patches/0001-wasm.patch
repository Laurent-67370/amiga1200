+#ifdef __EMSCRIPTEN__
+	/* WebAssembly : un mmap anonyme y est un malloc suivi d'une mise à zéro de toute la réserve (2 s pour 384 Mo
+	   au démarrage). La mémoire prise au sommet du tas par sbrk est neuve, donc déjà à zéro : l'allocateur
+	   d'Emscripten ne rend jamais de mémoire (MORECORE_CANNOT_TRIM) */
+	(void)mmap_flags;
+	{
+		const uintptr_t align = 65536;
+		void *base = sbrk(size + align);
+		if (base == (void *) -1)
+			return NULL;
+		address = (void *) (((uintptr_t) base + align - 1) & ~(align - 1));
+	}
+#else
 	address = mmap((void *) try_addr, size, PROT_NONE, mmap_flags, -1, 0);
 	if (address == MAP_FAILED) {
 		return NULL;
 	}
 #endif
+#endif
 #ifdef CPU_64_BIT
 	if (flags & UAE_VM_32BIT) {
 		uintptr_t end = (uintptr_t) address + size;
