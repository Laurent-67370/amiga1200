{
  "name": "Amiga — émulateur (WinUAE 6)",
  "short_name": "Amiga",
  "description": "Émulateur Amiga (A500, A600, A1200, A3000, A4000, CD32, CDTV) avec les cœurs WinUAE 6 et PUAE : disquettes, disques durs, WHDLoad, CD, sauvegardes. Fonctionne hors ligne une fois installé.",
  "lang": "fr",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#1f2430",
  "theme_color": "#2b303b",
  "categories": [
    "games",
    "entertainment",
    "utilities"
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/octet-stream": [
          ".adf",
          ".adz",
          ".dms",
          ".hdf",
          ".hdz",
          ".lha",
          ".lzh",
          ".uae",
          ".iso",
          ".cue"
        ]
      }
    }
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
