{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "electron": ["web/shims/electron.ts"],
      "fs/promises": ["web/shims/fs-promises.ts"],
      "fs": ["web/shims/fs.ts"],
      "path": ["web/shims/path.ts"],
      "@renderer/*": ["68k-trainer/src/renderer/src/*"],
      "@shared/*": ["68k-trainer/src/shared/*"]
    }
  },
  "include": ["web/**/*.ts", "68k-trainer/src/renderer/src/**/*.ts", "68k-trainer/src/shared/**/*.ts"]
}
